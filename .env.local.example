OPENROUTER_API_KEY=sk-or-...
# verify exact slug on openrouter.ai/models
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
JEV_MODEL=typesafe/jev-1.13
# Jev `confidence` needed to fly straight to a part; below it the "Did you mean..." picker shows
JEV_CONFIDENCE_THRESHOLD=0.5
# Set to 1 after `npm run regions` to use the two-step region -> part lookup (spec 6.3 fallback)
USE_REGIONS=0

# Text to speech (server only). Key needs the text_to_speech permission.
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL=eleven_flash_v2_5
